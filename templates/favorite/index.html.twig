{% extends 'base.html.twig' %}

{% block title %}Mes favoris{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Mes favoris</h1>

    {% if tracks is empty %}
        <p class="text-muted">Tu n'as pas encore de favoris.</p>
    {% else %}
        <div class="list-group">
            {% for track in tracks %}
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>{{ track.title }}</strong>
                        — {{ track.album.title }}
                    </div>
                    <a href="{{ path('app_favorite', {track_id: track.id}) }}" class="btn btn-sm btn-outline-danger">
                        ❤️ Retirer
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}